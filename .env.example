# ─────────────────────────────────────────────────────────────────────────────
# Environment variables. Copy to .env.local and fill in.
#
# Every variable the app reads is listed here and validated at start-up by src/env.ts.
# Nothing else reads process.env. Values marked [SECRET] must never be committed, logged,
# pasted into Studio or given a NEXT_PUBLIC_ name. NEXT_PUBLIC_ values are sent to browsers.
# The values below are safe placeholders: the app runs locally with them and with no
# third-party account (console email, local file storage, fixture AI, fake Stripe).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Node mode: development, test or production.
NODE_ENV=development
# Which deployment this is: local, test, preview or production. Safety guards key off this.
APP_ENV=local
# Product name shown to users (browser-visible). Change here to rename the product.
NEXT_PUBLIC_BRAND_NAME="[Platform Name]"
# Public address of the site, no trailing slash (browser-visible). Used in emails and signed links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Time zone for dates shown to users and for job schedules.
TZ_DISPLAY=Europe/London

# ── Database (Postgres, London region) ───────────────────────────────────────
# [SECRET] Connection string used by the app (pooled, if the provider offers a pooler).
DATABASE_URL=postgres://app:app@localhost:5432/platform_dev
# [SECRET] Optional direct (unpooled) connection string, used for migrations.
# DATABASE_URL_UNPOOLED=

# ── Sign-in (Better Auth) ────────────────────────────────────────────────────
# [SECRET] At least 32 characters. Signs sessions and local file links. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
# Address Better Auth builds its links from. Normally the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000
# Staff must pass two-step sign-in. false is allowed only when APP_ENV is local or test; start-up fails otherwise.
STAFF_2FA_REQUIRED=true
# Email address that becomes the first owner (super admin) when the database is seeded.
OWNER_BOOTSTRAP_EMAIL=owner@example.test
# [SECRET] Password given to seeded demo accounts. Local and test only: must be unset in production.
SEED_PASSWORD=change-me-local-only
# Breached-password check: local (bundled list) or hibp (Have I Been Pwned range API; needs the owner's approval).
PASSWORD_BREACH_CHECK=local
# How a parent of a 13 to 15 year old is verified: card_or_subscription, parent_email, or off_dev_only (never in production).
AGE_ASSURANCE_MODE=card_or_subscription

# ── AI: Coach and course drafting ────────────────────────────────────────────
# fixture (canned replies, no provider) or gateway (live models; each provider must also be approved in Studio).
AI_PROVIDER_MODE=fixture
# [SECRET] Vercel AI Gateway key. Needed only when AI_PROVIDER_MODE=gateway.
# AI_GATEWAY_API_KEY=
# Moderation: rules (local keyword and pattern classifier) or gateway (a moderation model).
MODERATION_PROVIDER=rules
# [SECRET] Key for the moderation provider, if it needs its own.
# MODERATION_API_KEY=
# Detecting real people in uploads: manual (a person checks every image or video) or fixture (tests).
PEOPLE_DETECTION_PROVIDER=manual
# Daily AI spend cap in pounds. Admins are alerted at 80%; the kill switch trips at 100%.
AI_DAILY_SPEND_CAP_GBP=20
# Optional per-feature daily caps in pounds, as JSON, e.g. {"coach":15,"drafting":5}.
AI_FEATURE_CAPS_JSON={}
# Value of one Coach credit in pence (defaults; live values are editable in Studio).
CREDIT_VALUE_PENCE=0.1
# Coach credits per learner per month on the Free plan.
FREE_MONTHLY_CREDITS=50
# Coach credits per learner per month on the Family plan.
FAMILY_MONTHLY_CREDITS=200

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# fake (no Stripe account needed; not allowed in production) or stripe.
STRIPE_DRIVER=fake
# [SECRET] Stripe secret key (sk_test_... locally, sk_live_... in production).
# STRIPE_SECRET_KEY=
# [SECRET] Signing secret for the Stripe webhook endpoint (whsec_...).
# STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (browser-visible; parent and adult checkout only).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe price ids for each plan (not secret). Prices themselves live in Stripe and the database.
# STRIPE_PRICE_FAMILY_MONTHLY=
# STRIPE_PRICE_FAMILY_ANNUAL=
# STRIPE_PRICE_FAMILY_FOUNDING_MONTHLY=
# STRIPE_PRICE_FAMILY_FOUNDING_ANNUAL=
# STRIPE_PRICE_EXTRA_SEAT_MONTHLY=

# ── File storage ─────────────────────────────────────────────────────────────
# local (files under STORAGE_LOCAL_DIR) or s3 (AWS S3 eu-west-2, Cloudflare R2 or Supabase Storage).
STORAGE_PROVIDER=local
# Folder for the local driver. Keep it outside the web root and out of git.
STORAGE_LOCAL_DIR=.data/storage
# Bucket for learner uploads, exports and anything personal. Must be private.
STORAGE_BUCKET_PRIVATE=private
# Bucket for course assets. Still reached only through signed links.
STORAGE_BUCKET_PUBLIC=public
# S3-compatible endpoint. Leave unset for AWS; set for R2 (https://<account>.eu.r2.cloudflarestorage.com) or Supabase (https://<project>.supabase.co/storage/v1/s3).
# STORAGE_S3_ENDPOINT=
# Region: eu-west-2 for AWS London, auto for R2, the project region for Supabase.
STORAGE_S3_REGION=eu-west-2
# [SECRET] S3 access key id.
# STORAGE_S3_ACCESS_KEY_ID=
# [SECRET] S3 secret access key.
# STORAGE_S3_SECRET_ACCESS_KEY=
# Supabase project URL, if Supabase is used (the storage endpoint is derived from it when STORAGE_S3_ENDPOINT is unset).
# SUPABASE_URL=
# [SECRET] Supabase service-role key. Server only; bypasses row-level security.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Email (transactional only; never marketing, never to under-18s) ──────────
# console (logs a summary; nothing is sent; not usable in production), resend or postmark.
EMAIL_PROVIDER=console
# [SECRET] API key for Resend, or the server token for Postmark.
# EMAIL_API_KEY=
# The From line. Use a domain you have verified with the provider.
EMAIL_FROM="[Platform Name] <hello@example.test>"
# Optional Reply-To address, e.g. your support inbox.
# EMAIL_REPLY_TO=

# ── Background jobs ──────────────────────────────────────────────────────────
# [SECRET] Inngest event key. When unset (and INNGEST_DEV is false) jobs run inside the app process instead.
# INNGEST_EVENT_KEY=
# [SECRET] Inngest signing key. Verifies that calls to /api/inngest really come from Inngest.
# INNGEST_SIGNING_KEY=
# true to use a local Inngest dev server (npx inngest-cli dev). Never true in production.
INNGEST_DEV=false
# [SECRET] At least 16 characters. Bearer token for the cron fallback, POST /api/jobs/<name>. Generate: openssl rand -hex 24
CRON_SECRET=replace-with-a-long-random-string

# ── Safety ───────────────────────────────────────────────────────────────────
# [SECRET] 64 hex characters. Encrypts safeguarding case notes. Losing it makes those notes unreadable. Generate: openssl rand -hex 32
SAFEGUARDING_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32
# [SECRET] 64 hex characters. Encrypts Coach conversations. Use a different key from the one above.
CONTENT_ENCRYPTION_KEY=replace-with-64-different-hex-characters-from-openssl-rand
# Comma-separated addresses alerted at once about critical and high safeguarding cases (the DSL).
DSL_ALERT_EMAILS=owner@example.test
# Comma-separated addresses for the deputy, used only when deputy escalation is switched on in Studio.
DEPUTY_DSL_ALERT_EMAILS=

# ── Optional services (each needs the owner's approval before it is switched on) ──
# [SECRET] Sentry DSN for error monitoring (EU region, personal data scrubbed, no session replay).
# SENTRY_DSN=
# PostHog project key (browser-visible). Parent and marketing pages only, after cookie consent. Never learner areas.
# NEXT_PUBLIC_POSTHOG_KEY=
# [SECRET] Cloudflare Turnstile secret key, for bot protection on sign-up.
# TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile site key (browser-visible).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Tool Radar and course drafting (defaults; live values are editable in Studio) ──
# Switch scheduled discovery of new AI tools on.
RADAR_ENABLED=false
# Use bundled fixture sources instead of the network. Local and test only: must be false in production.
RADAR_FIXTURES=true
# A candidate at or above this score (0 to 100) gets an automatic draft course.
RADAR_AUTODRAFT_THRESHOLD=70
# Most that one draft may cost, in pounds.
RADAR_MAX_COST_PER_DRAFT_GBP=1.5
# Monthly budget for drafting, in pounds. Auto-drafting pauses when it is reached.
RADAR_MONTHLY_BUDGET_GBP=40
# User-Agent sent when Radar fetches public pages. Include a contact address.
RADAR_USER_AGENT="PlatformRadar/1.0 (+http://localhost:3000/radar)"
# [SECRET] Product Hunt API token. Optional; ask the owner before adding this source.
# PRODUCTHUNT_API_TOKEN=
# [SECRET] GitHub token for higher rate limits on public data. Optional; no scopes needed.
# GITHUB_TOKEN=
